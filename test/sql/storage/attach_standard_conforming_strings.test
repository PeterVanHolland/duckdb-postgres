# name: test/sql/storage/attach_standard_conforming_strings.test
# description: Backslashes in the SQL sent to Postgres stay plain characters when the session reads them as escapes
# group: [storage]

require postgres_scanner

require-env POSTGRES_TEST_DATABASE_AVAILABLE

statement ok
ATTACH 'dbname=postgresscanner options=-cstandard_conforming_strings=off' AS s (TYPE POSTGRES)

statement ok
CREATE OR REPLACE TABLE s.public.standard_strings (s VARCHAR)

statement ok
INSERT INTO s.public.standard_strings VALUES ('a\tb'), ('plain')

query I
SELECT count(*) FROM s.public.standard_strings WHERE s = 'a\tb'
----
1

query I
SELECT count(*) FROM s.public.standard_strings WHERE s LIKE 'a\t%'
----
1

statement ok
CALL postgres_execute('s', 'INSERT INTO public.standard_strings VALUES (''c\d'')')

query I
SELECT s FROM s.public.standard_strings ORDER BY s
----
a\tb
c\d
plain

# connections that the pool resets keep the setting
loop i 0 4

query I
SELECT * FROM postgres_query('s', 'SELECT current_setting(''standard_conforming_strings'')')
----
on

endloop

statement ok
DROP TABLE s.public.standard_strings
